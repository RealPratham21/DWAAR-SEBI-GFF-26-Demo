POSTGRES_DB=dwaar
POSTGRES_USER=dwaar
POSTGRES_PASSWORD=dwaar_local

DATABASE_URL=postgresql+psycopg://dwaar:dwaar_local@db:5432/dwaar

APP_NAME=Dwaar API
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

JWT_SECRET=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=dwaar_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=localhost

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
INTERNAL_API_BASE_URL=http://backend:8000/api/v1

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dwaar_minio
S3_SECRET_KEY=dwaar_minio_secret
S3_BUCKET=dwaar-documents
S3_REGION=us-east-1
S3_SECURE=false
S3_PRESIGNED_EXPIRY_SECONDS=900

# Increment 2B — structured fact extraction (document-worker)
STRUCTURED_EXTRACTION_ENABLED=false
STRUCTURED_EXTRACTION_PROVIDER=cohere
STRUCTURED_EXTRACTION_MAX_ATTEMPTS=3
STRUCTURED_EXTRACTION_INPUT_MAX_CHARS=120000
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026
COHERE_TIMEOUT_SECONDS=60
COHERE_MAX_RETRIES=2
COHERE_TEMPERATURE=0
# Optional live Cohere smoke: STRUCTURED_EXTRACTION_LIVE_TEST=true
