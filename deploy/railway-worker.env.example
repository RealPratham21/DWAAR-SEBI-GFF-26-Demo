# Railway document-worker service — placeholders only. Do not commit real credentials.
# Same Docker image as the API; different start command and SERVICE_ROLE.

SERVICE_ROLE=worker
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Reference: same Railway PostgreSQL as API
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# Reference: same Railway Bucket as API
S3_ENDPOINT=${{Bucket.ENDPOINT}}
S3_PUBLIC_ENDPOINT=${{Bucket.ENDPOINT}}
S3_ACCESS_KEY=${{Bucket.ACCESS_KEY_ID}}
S3_SECRET_KEY=${{Bucket.SECRET_ACCESS_KEY}}
S3_BUCKET=${{Bucket.BUCKET}}
S3_REGION=${{Bucket.REGION}}
S3_SECURE=true
S3_ADDRESSING_STYLE=virtual
S3_PRESIGNED_EXPIRY_SECONDS=900

STRUCTURED_EXTRACTION_ENABLED=true
STRUCTURED_EXTRACTION_PROVIDER=cohere
COHERE_API_KEY=<cohere-api-key>
COHERE_MODEL=command-a-plus-05-2026
COHERE_TIMEOUT_SECONDS=60
COHERE_MAX_RETRIES=2
COHERE_TEMPERATURE=0
STRUCTURED_EXTRACTION_MAX_ATTEMPTS=3
STRUCTURED_EXTRACTION_STALE_HEARTBEAT_SECONDS=120
STRUCTURED_EXTRACTION_INPUT_MAX_CHARS=120000

DOC_PROCESSING_POLL_INTERVAL_SECONDS=2
DOC_PROCESSING_MAX_ATTEMPTS=3
DOC_PROCESSING_TIMEOUT_SECONDS=300
DOC_PROCESSING_HEARTBEAT_INTERVAL_SECONDS=15
DOC_PROCESSING_STALE_HEARTBEAT_SECONDS=90
DOC_PROCESSING_MAX_PAGES=50
DOC_PROCESSING_OCR_DPI=280
DOC_PROCESSING_MAX_IMAGE_PIXELS=40000000
DOC_PROCESSING_MAX_RENDER_PIXELS=25000000
# Railway ephemeral FS — file heartbeat is optional and not used for platform health
DOC_PROCESSING_WRITE_HEARTBEAT_FILE=false

# Railway service settings (console, not env):
# - No public domain
# - Replicas: 1
# - Restart: always / on failure
# - Memory: start ~1–1.5 GB; raise only after observing OCR usage
# - Start command:
#   uv run --no-dev python -m app.modules.company_incorporation.document_processing.worker
