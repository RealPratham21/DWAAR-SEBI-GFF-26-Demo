# Railway API service — placeholders only. Do not commit real credentials.
# Prefer Railway service-reference / shared variables for DATABASE_URL and S3_* where available.

SERVICE_ROLE=api
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
ENABLE_API_DOCS=false

# Reference: Railway PostgreSQL → DATABASE_URL (postgresql:// is normalised automatically)
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# Generate a long random secret (≥32 chars). Never reuse local defaults.
JWT_SECRET=<generate-long-random-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_EXPIRE_DAYS=30

REFRESH_COOKIE_NAME=dwaar_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=none
# Leave unset unless using a shared custom domain:
# REFRESH_COOKIE_DOMAIN=

# Exact Vercel production origin (no wildcard *.vercel.app)
FRONTEND_ORIGINS=https://<frontend>.vercel.app
# Railway public API hostname (and optional custom domain)
TRUSTED_HOSTS=<api>.up.railway.app

# Railway private Storage Bucket — use reference variables from the Bucket service
S3_ENDPOINT=${{Bucket.ENDPOINT}}
S3_PUBLIC_ENDPOINT=${{Bucket.ENDPOINT}}
S3_ACCESS_KEY=${{Bucket.ACCESS_KEY_ID}}
S3_SECRET_KEY=${{Bucket.SECRET_ACCESS_KEY}}
S3_BUCKET=${{Bucket.BUCKET}}
S3_REGION=${{Bucket.REGION}}
S3_SECURE=true
S3_ADDRESSING_STYLE=virtual
S3_PRESIGNED_EXPIRY_SECONDS=900

# Shared processing knobs (API does not require Cohere to start)
STRUCTURED_EXTRACTION_ENABLED=true
STRUCTURED_EXTRACTION_PROVIDER=cohere
DOC_PROCESSING_ALLOW_FULL_CONTENT_API=false
